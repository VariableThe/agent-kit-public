# Local secrets — create from service.json.example, never commit the real file.
service.json
auth.json

# Skill credentials — the shipped example files stay, the real ones never do.
skills/*/credentials.env
skills/*/credentials.local.env
*.env.local

# Local-only private-context terms for the public release gate.
scripts/private-context.local.txt

# Node (the Beeper bridge)
node_modules/
bun.lock
npm-debug.log*
*.log

# Installer-generated config backups
opencode.json.bak-*
*.bak-*

# Python
__pycache__/
*.pyc
.venv/

# Generated skill output
*.pdf
*.png
*.jpg
*.wav

# macOS
.DS_Store
